     "kind": "law"
    }
   ],
   "date": "1989"
  },
  {
   "say": "Australia settled in nineteen ninety three and paid more than a hundred million dollars. Very little of the dead land was ever restored.",
   "visuals": [
    {
     "type": "image",
     "search": [
      "Nauru mined land rehabilitation"
