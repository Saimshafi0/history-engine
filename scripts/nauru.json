     "source": "stock"
    },
    {
     "type": "image",
     "search": [
      "Nauru phosphate mining pit"
     ]
    }
   ]
  },
  {
   "say": "What was left was a forest of grey coral pinnacles, some taller than a man. About eighty percent of Nauru became land where nothing could grow and nobody could live.",
   "visuals": [
    {
     "type": "image",
     "search": [
      "Nauru pinnacles coral limestone",
      "Nauru mined phosphate pinnacles"
