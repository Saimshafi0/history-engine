   "chapter": "A rock in the ocean",
   "mood": "mystery"
  },
  {
   "say": "It is the third smallest country in the world. Only Vatican City and Monaco are smaller.",
   "visuals": [
    {
     "type": "image",
     "search": [
      "Vatican City aerial",
      "Vatican City Saint Peter's Square"
