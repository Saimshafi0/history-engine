     "source": "stock"
    }
   ],
   "date": "1993"
  },
  {
   "say": "And because the land could no longer feed anyone, the food came by ship. Canned meat. White rice. Sugary drinks.",
   "visuals": [
    {
     "type": "video",
     "search": [
      "cargo containers ship port"
