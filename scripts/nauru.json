     "text": "80%",
     "label": "of the island dug out",
     "on": "eighty",
     "kind": "fact"
    }
   ]
  },
  {
   "say": "Almost the whole population now lived on a thin ring of coast around the edge.",
   "visuals": [
    {
     "type": "image",
     "search": [
      "Nauru coastal village",
      "Nauru houses coast"
     ]
    },
    {
     "type": "image",
     "search": [
      "Nauru Aiwo district"
     ]
    }
   ]
  },
  {
   "say": "In nineteen eighty nine, tiny Nauru took Australia to the International Court of Justice, demanding money to repair the land mined before independence.",
   "visuals": [
    {
     "type": "image",
     "search": [
