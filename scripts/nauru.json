     ]
    },
    {
     "type": "video",
     "search": [
      "stock market numbers screen"
     ],
     "source": "stock"
    }
   ]
  },
  {
   "say": "Nobody paid income tax. Electricity was cheap. Young Nauruans were sent abroad to study, all expenses paid.",
   "visuals": [
