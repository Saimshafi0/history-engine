      "Monaco harbour aerial"
     ]
    },
    {
     "type": "image",
     "search": [
      "Nauru Anibare Bay"
     ]
    }
   ]
  },
  {
   "say": "For thousands of years, a few thousand Nauruans lived here by fishing, gathering coconuts, and farming the land around a small lagoon.",
   "visuals": [
    {
     "type": "image",
     "search": [
      "Nauru Buada Lagoon"
     ]
    },
    {
     "type": "video",
     "search": [
      "fishing canoe pacific ocean"
     ],
     "source": "stock"
    },
    {
     "type": "image",
     "search": [
      "Nauruan people 1900s photograph",
      "Nauru natives 1910"
     ]
    }
   ]
  },
  {
   "say": "But under their feet was something the outside world wanted very, very badly.",
   "visuals": [
    {
     "type": "video",
     "search": [
      "hands digging soil close up"
     ],
     "source": "stock"
    },
    {
     "type": "image",
     "search": [
      "phosphate rock",
      "phosphate mineral sample"
     ]
    }
   ]
  },
  {
   "say": "Phosphate. The rock that turns into fertilizer. And in the early nineteen hundreds, the farms of Australia, New Zealand and Britain were hungry for it.",
   "visuals": [
    {
     "type": "image",
     "search": [
      "phosphate fertilizer",
      "superphosphate fertilizer bag"
     ]
    },
    {
     "type": "video",
     "search": [
      "tractor field fertilizer spreading"
     ],
     "source": "stock"
    },
    {
     "type": "image",
     "search": [
      "Australian wheat farm 1920s"
     ]
    }
   ],
   "pops": [
    {
     "text": "PHOSPHATE",
     "label": "fertilizer for half the world",
     "on": "Phosphate",
     "kind": "money"
    }
   ]
  },
  {
   "say": "How it got there is still argued about. One old theory says millions of years of seabird droppings settled on an ancient coral reef, and slowly turned to stone.",
